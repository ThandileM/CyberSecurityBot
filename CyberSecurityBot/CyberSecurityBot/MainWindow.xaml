<Window x:Class="CyberSecurityBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityBot"
        mc:Ignorable="d"
        Title="CyberSecurity Chatbot" Height="600" Width="900" Background="Black">
    <Grid>
        <!-- Title -->
            <TextBlock Text="CYBERSECURITY AWARENESS CHATBOT" 
                   FontSize="28" 
                   FontWeight="Bold"
                   Foreground="LightCyan" 
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,0"/>

        <!-- Chat Display -->
            <TextBox Name="ChatDisplay" 
                 Margin="20,80,20,100" 
                 Background="Black" 
                 Foreground="Red" 
                 FontSize="16" 
                 IsReadOnly="True" 
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

        <!-- User Input -->
            <TextBox Name="UserInput" 
                 Height="40"
                 Margin="20,0,140,20"
                 FontSize="16" 
                 VerticalAlignment="Bottom"/>

        <!-- Send Button -->
            <Button Content="Send" 
                Margin="0,0,20,20" 
                Width="100" 
                Height="40" 
                Background="Pink"
                FontWeight="Bold"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Click="SendButton_Click"/>

    </Grid>
</Window>
